# ======================
# Python caches / compiled
# ======================
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ======================
# Environments / secrets
# ======================
.env
.venv/
venv/
ENV/
*.env
*.local

# Conda (optional; keep if you ever export these)
conda-meta/
*.conda
*.mamba

# ======================
# OS / editor junk
# ======================
.DS_Store
Thumbs.db
.idea/
.vscode/

# ======================
# Notebooks
# ======================
.ipynb_checkpoints/

# ======================
# Docs build output (MkDocs)
# ======================
site/

# ======================
# Node / React
# ======================
web/node_modules/
web/dist/
web/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ======================
# Data pipeline outputs (large)
# ======================
data/raw/
data/interim/

# Ignore all composites by default...
data/*
!data/composites/.gitkeep

# Delta rasters are generated/cached
data/change/

# Legacy/old/deprecated folders
data/composites-old/
data/dep/
src/legacy/

# ======================
# Geospatial sidecars (keep GeoJSON)
# ======================
data/aoi/*.shp
data/aoi/*.shx
data/aoi/*.dbf
data/aoi/*.prj
data/aoi/*.cpg

# If you ever export other GIS formats, ignore them too
*.gpkg
*.kml
*.kmz

# ======================
# Raster formats (global)
# ======================
# Ignore large rasters everywhere by default...
*.tif
*.tiff
*.nc
*.zarr/
*.SAFE
*.zip

# ...but re-include the small example composites (must come AFTER the ignores above)
!data/composites/ndvi_median_1995.tif
!data/composites/ndvi_median_2002.tif
!data/composites/ndvi_median_2021.tif